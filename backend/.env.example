# Copy this file as .env in the backend directory.
DATABASE_PATH=./lifepilot.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional: Enables a genuine hosted AI assistant. Keep this key SECRET, only in backend/.env.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: Sends emails when reminders become due, while backend is running.
# Without SMTP, reminders work in the app/browser whenever the site is open.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
REMINDER_TO_EMAIL=
SMTP_USE_TLS=true
